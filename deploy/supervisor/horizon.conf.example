[program:erm-saleops-horizon]
process_name=%(program_name)s
command=/usr/bin/php /var/www/erm-saleops/artisan horizon
directory=/var/www/erm-saleops
autostart=true
autorestart=true
user=www-data
redirect_stderr=true
stdout_logfile=/var/www/erm-saleops/storage/logs/horizon.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=10
stopwaitsecs=1800
stopasgroup=true
killasgroup=true
environment=APP_ENV="production"
