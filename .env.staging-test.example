APP_ENV=staging
APP_DEBUG=false
APP_URL=http://erm-pushsale.duckdns.org

# Tạm bypass login để QA/bot có thể mở toàn bộ màn hình web.
ERM_AUTO_ADMIN_LOGIN=true
ERM_AUTO_ADMIN_LOGIN_HOSTS=erm-pushsale.duckdns.org
# ERM_AUTO_ADMIN_LOGIN_EMAIL=admin@saleops.local
# ERM_AUTO_ADMIN_LOGIN_USER_ID=1

# Test gateway public, chỉ bật trên con staging duckdns.
ERM_STAGING_TEST_MODE=true
ERM_STAGING_TEST_HOSTS=erm-pushsale.duckdns.org
ERM_STAGING_TEST_BASE_URL=http://erm-pushsale.duckdns.org
ERM_STAGING_TEST_SECRET=change-this-long-random-secret
ERM_STAGING_TEST_ALLOW_ARTISAN=true
ERM_STAGING_TEST_HTTP_TIMEOUT=25

# Để test flow dễ hơn. Khi test xong có thể chuyển lại redis.
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
