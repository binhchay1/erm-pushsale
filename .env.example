# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  ERM SaleOps — Environment Configuration Template                       ║
# ║  Copy file này thành .env và điền giá trị thực.                         ║
# ║  Không commit file .env vào Git.                                         ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="ERM SaleOps"
# production | local | staging
APP_ENV=local
# Tạo bằng: php artisan key:generate
APP_KEY=
# Bắt buộc đặt false khi production
APP_DEBUG=true
# URL công khai của app, không có dấu / cuối
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
# Production: đổi sang error hoặc warning
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# Hỗ trợ: pgsql (khuyến nghị) | mysql | sqlite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erm_pushsale
DB_USERNAME=postgres
DB_PASSWORD=

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production: đặt thành tên miền thực, ví dụ: example.com
SESSION_DOMAIN=null

# ── Queue & Cache ────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
# Nếu dùng Redis (khuyến nghị cho production):
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
#
# Worker xử lý các queue tách biệt theo độ ưu tiên:
#   notifications  → tạo + broadcast thông báo (đẩy ra khỏi request)
#   default        → ingest lead, tạo vận đơn, webhook...
#   translations   → dịch tự động free-text (ưu tiên thấp nhất)
# Lệnh production (Supervisor/systemd):
#   php artisan queue:work --queue=notifications,default,translations --tries=3

# ── Dịch tự động (Auto-translation) ──────────────────────────────────────────
# Chỉ dùng cho free-text không có i18n key. Tắt mặc định → app vẫn chạy offline,
# nội dung giữ nguyên ngôn ngữ gốc nếu không bật/không có mạng.
TRANSLATION_ENABLED=false
# mymemory (miễn phí, không cần key) | libretranslate (self-host, riêng tư)
TRANSLATION_DRIVER=mymemory
TRANSLATION_SOURCE_LOCALE=vi
TRANSLATION_TIMEOUT=8
# MyMemory: thêm email để tăng quota ẩn danh (tùy chọn)
# TRANSLATION_MYMEMORY_EMAIL=
# LibreTranslate self-host (khuyến nghị cho dữ liệu nội bộ):
# TRANSLATION_DRIVER=libretranslate
# LIBRETRANSLATE_ENDPOINT=http://127.0.0.1:5000/translate
# LIBRETRANSLATE_API_KEY=

# ── Redis (tùy chọn) ─────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Broadcast / Reverb (realtime notifications) ───────────────────────────────
BROADCAST_CONNECTION=reverb
# Tạo chuỗi ngẫu nhiên dài cho production
REVERB_APP_ID=erm-pushsale
REVERB_APP_KEY=erm-pushsale-key
REVERB_APP_SECRET=erm-pushsale-secret
# Production: đặt thành domain/IP thực của server
REVERB_HOST=localhost
# Production dùng HTTPS: REVERB_PORT=443, REVERB_SCHEME=https
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Filesystem ───────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ─────────────────────────────────────────────────────────────────────
# Production: đổi sang smtp, mailgun, ses, ...
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Sanctum / CORS ───────────────────────────────────────────────────────────
# Production: đặt đúng domain, ví dụ: example.com,www.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ── Tích hợp nền tảng (Integrations) ─────────────────────────────────────────

# Webhook chung
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_TOLERANCE=300

# Facebook Lead Ads
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=

# TikTok
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# Zalo OA
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_ACCESS_TOKEN=

# Landing form
LANDING_API_KEY=

# Google Ads leads
GOOGLE_LEADS_WEBHOOK_KEY=

# Shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=

# Lazada
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=

# ── Phân bổ Lead ─────────────────────────────────────────────────────────────
LEAD_ROUTING_STRATEGY=round_robin
LEAD_DUPLICATE_WINDOW_DAYS=30

# ── Vận chuyển — Shipping carriers ───────────────────────────────────────────
# Các giá trị .env là fallback mặc định khi chưa cấu hình qua giao diện Admin.
# Ưu tiên: DB (cấu hình Admin) → .env → bỏ trống.

# SSL verification — production luôn để true
SHIPPING_VERIFY_SSL=true
# Tùy chọn: đường dẫn tới CA bundle tùy chỉnh (mặc định dùng certs/cacert.pem trong project)
# SHIPPING_CA_BUNDLE=/path/to/cacert.pem

# Thông tin kho lấy hàng mặc định
SHIPPING_PICK_NAME="ERM SaleOps Kho"
SHIPPING_PICK_TEL=0900000000
SHIPPING_PICK_ADDRESS="Địa chỉ kho lấy hàng"
SHIPPING_PICK_PROVINCE="Hà Nội"
SHIPPING_PICK_DISTRICT="Quận Cầu Giấy"
SHIPPING_PICK_WARD="Phường Dịch Vọng"

# Tỉnh/Quận mặc định khi không parse được địa chỉ khách
SHIPPING_DEFAULT_PROVINCE="Hà Nội"
SHIPPING_DEFAULT_DISTRICT="Quận Hoàn Kiếm"
SHIPPING_DEFAULT_WARD="Phường Hàng Bài"

# GHTK — Giao Hàng Tiết Kiệm
GHTK_TOKEN=
GHTK_PARTNER_CODE=
# Sandbox (true = dùng staging URL cho test, false = production)
GHTK_USE_SANDBOX=false
# ID địa chỉ lấy hàng đã tạo sẵn trên GHTK (lấy từ API pick-addresses)
GHTK_PICK_ADDRESS_ID=

# GHN — Giao Hàng Nhanh
GHN_TOKEN=
GHN_SHOP_ID=
GHN_CLIENT_ID=

# Viettel Post
VIETTEL_POST_TOKEN=
VIETTEL_POST_USERNAME=
VIETTEL_POST_PASSWORD=
VIETTEL_POST_CUSTOMER_CODE=

# J&T Express
JNT_API_KEY=
JNT_API_SECRET=
JNT_CLIENT_CODE=

# SPX Express (merchant API do SPX cấp riêng)
SPX_API_BASE_URL=
SPX_USER_ID=
SPX_SECRET_KEY=
SPX_ACCOUNT_ID=
SPX_API_VERSION=v1
SPX_CREATE_ORDER_PATH=
SPX_ORDER_DETAIL_PATH=
SPX_FEE_PATH=
SPX_CANCEL_ORDER_PATH=
SPX_LABEL_PATH=
SPX_TEST_CONNECTION_PATH=
SPX_SIGNATURE_HEADER=X-Signature
SPX_TIMESTAMP_HEADER=X-Timestamp

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
